<elements:AsyncWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:elements="clr-namespace:TgaBuilderAvaloniaUi.Elements"
    xmlns:local="clr-namespace:TgaBuilderAvaloniaUi.View"
    xmlns:converters="clr-namespace:TgaBuilderAvaloniaUi.Converters"
    xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
    xmlns:ap="clr-namespace:TgaBuilderAvaloniaUi.AttachedProperties"
    x:Class="TgaBuilderAvaloniaUi.View.TransitionWindow"
    x:DataType="viewmodel:TransitionViewModel"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    Background="{DynamicResource WindowBackgroundGradient}"
    Foreground="{DynamicResource SystemBaseHighColor}"
    Title="Transition Helper"
    Width="730"
    Height="300"
    MinWidth="690"
    MinHeight="300"
    Icon="avares://TgaBuilderAvaloniaUi/Resources/TgaBuilder_icon.ico">

    <!-- ========================================================================= -->
    <!-- WINDOW RESOURCES & CONVERTERS                                             -->
    <!-- ========================================================================= -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude
                    Source="/Styles/CheckerBrush.axaml" />
                <ResourceInclude
                    Source="/Styles/TabControlStyles.axaml" />
                <ResourceInclude
                    Source="/Styles/IconToggleButtonStyle.axaml" />
                <ResourceInclude
                    Source="/Styles/IconButtonStyle.axaml" />
                <ResourceInclude
                    Source="/Styles/IconRadioButtonStyle.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:WriteableBitmapConverter
                x:Key="WriteableBitmapConverter" />
            <converters:ColorStructToMediaColor
                x:Key="ColorStructToMediaColor" />
            <converters:EnumToBooleanConverter
                x:Key="EnumToBooleanConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- ========================================================================= -->
    <!-- MAIN CONTENT LAYOUT                                                       -->
    <!-- ========================================================================= -->
    <Grid
        RowDefinitions="Auto,*,60">

        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="3*"
                MinWidth="420" />
            <ColumnDefinition
                Width="*"
                MinWidth="220" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- TOP ROW: MODE SELECTOR + TRANSITION MODES + PIVOT                        -->
        <!-- ========================================================================= -->
        <DockPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="7,0,10,0">

            <!-- Mode Selector: Smooth / Brick radio icon buttons -->
            <StackPanel
                DockPanel.Dock="Left"
                Orientation="Horizontal"
                Margin="0,0,6,0"
                VerticalAlignment="Center">
                <elements:IconRadioButton
                    Icon="{StaticResource tab_in_private}"
                    Classes="outlined"
                    IsChecked="{Binding SelectedTransitionType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static viewmodel:TransitionType.Smooth}}"
                    ap:MouseOverInfoAP.InfoText="Smooth transition mode"/>

                <elements:IconRadioButton
                    IsChecked="{Binding SelectedTransitionType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static viewmodel:TransitionType.Bricks}}"
                    Classes="outlined"
                    Margin="5,0,5,0"
                    Icon="{StaticResource table_freeze_regular}"
                    ap:MouseOverInfoAP.InfoText="Brick transition mode"/>

            </StackPanel>

            <!-- Transition mode buttons panel -->
            <local:TransitionModeUserControl />

            <!-- Pivot slider -->
            <DockPanel
                Margin="5,2,0,0"
                ap:MouseOverInfoAP.InfoText="Pivot: sets the position of the transition border (0 = left, 1 = right)">
                <Grid
                    VerticalAlignment="Top"
                    Margin="0,11,8,0"
                    DockPanel.Dock="Left">
                    <Path
                        VerticalAlignment="Bottom"
                        Stroke="{DynamicResource IconFillBrush}"
                        StrokeThickness="1"
                        Fill="Transparent"
                        Width="10"
                        Height="10"
                        Data="{StaticResource pivot_low}" />
                    <Path
                        VerticalAlignment="Bottom"
                        Stroke="{DynamicResource IconFillBrush}"
                        StrokeDashArray="2,2"
                        StrokeThickness="1"
                        Fill="Transparent"
                        Width="10"
                        Height="10"
                        Data="{StaticResource pivot_high}" />
                </Grid>
                <Grid
                    VerticalAlignment="Top"
                    Margin="-5,11,8,0"
                    DockPanel.Dock="Right">
                    <Path
                        VerticalAlignment="Bottom"
                        StrokeThickness="1"
                        Stroke="{DynamicResource IconFillBrush}"
                        Fill="Transparent"
                        Width="10"
                        Height="10"
                        Data="{StaticResource pivot_high}" />
                    <Path
                        VerticalAlignment="Bottom"
                        StrokeThickness="1"
                        Stroke="{DynamicResource IconFillBrush}"
                        StrokeDashArray="2,2"
                        Fill="Transparent"
                        Width="10"
                        Height="10"
                        Data="{StaticResource pivot_low}" />
                </Grid>
                <elements:MouseWheelSlider
                    Margin="5,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding PivotValue}"
                    Maximum="1"
                    Minimum="0"
                    SmallChange="0.01"
                    Value="{Binding PivotValue}" />
            </DockPanel>
        </DockPanel>

        <!-- ========================================================================= -->
        <!-- LEFT PANEL: IMAGE PREVIEWS & PROCESSING                                   -->
        <!-- ========================================================================= -->
        <Grid
            x:Name="ImageAreaGrid"
            ColumnDefinitions="*, 35, *, 35, *, Auto, 0, Auto"
            Grid.Row="1"
            Grid.RowSpan="2"
            RowDefinitions="*,60">

            <!-- Source Image 1 -->
            <Border
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <Grid>
                    <Viewbox
                        Stretch="Uniform"
                        Margin="10"
                        RenderOptions.BitmapInterpolationMode="None">
                        <Grid
                            Width="{Binding Image1.PixelWidth, FallbackValue=128}"
                            Height="{Binding Image1.PixelHeight, FallbackValue=128}">
                            <elements:CheckerRectangle
                                TileDensity="1" />
                            <Image
                                x:Name="Image1"
                                RenderOptions.BitmapInterpolationMode="None"
                                Source="{Binding Image1, Converter={StaticResource WriteableBitmapConverter}}"
                                Stretch="Fill"
                                PointerMoved="Image1_PointerMoved"
                                PointerEntered="Image1_PointerEntered"
                                PointerExited="Image1_PointerExited"
                                PointerPressed="Image1_PointerPressed" />
                        </Grid>
                    </Viewbox>
                    <TextBlock
                        Text="Texture 1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        FontSize="24"
                        IsVisible="{Binding InitTextVisible}"
                        IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Swap Controls -->
            <StackPanel
                VerticalAlignment="Center"
                Grid.Column="1"
                Margin="0,45,0,0">
                <PathIcon
                    Data="{StaticResource add}"
                    Width="16"
                    Height="16" />
                <elements:IconButton
                    Classes="outlined"
                    Margin="0,9,0,0"
                    Padding="4,0,0,0"
                    Command="{Binding SwapImagesCommand}"
                    ap:MouseOverInfoAP.InfoText="Swap Texture 1 and Texture 2"
                    ToolTip.Tip="Swap images"
                    Icon="{StaticResource arrow_swap}" />
            </StackPanel>

            <!-- Source Image 2 -->
            <Border
                Grid.Column="2"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <Grid>
                    <Viewbox
                        Stretch="Uniform"
                        RenderOptions.BitmapInterpolationMode="None">
                        <Grid
                            Width="{Binding Image2.PixelWidth, FallbackValue=128}"
                            Height="{Binding Image2.PixelHeight, FallbackValue=128}">
                            <elements:CheckerRectangle
                                TileDensity="1" />
                            <Image
                                x:Name="Image2"
                                RenderOptions.BitmapInterpolationMode="None"
                                Source="{Binding Image2, Converter={StaticResource WriteableBitmapConverter}}"
                                Stretch="Fill"
                                PointerMoved="Image2_PointerMoved"
                                PointerEntered="Image2_PointerEntered"
                                PointerExited="Image2_PointerExited"
                                PointerPressed="Image2_PointerPressed" />
                        </Grid>
                    </Viewbox>
                    <TextBlock
                        Text="Texture 2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        FontSize="24"
                        IsVisible="{Binding InitTextVisible}"
                        IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Mix Command Arrow -->
            <elements:IconButton
                Classes="accent"
                Foreground="White"
                Grid.Column="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="0,0,0,-5"
                ap:MouseOverInfoAP.InfoText="Generate the transition result image"
                Icon="{StaticResource arrow_forward}"
                Command="{Binding MixCommand}" />

            <!-- Result Image -->
            <Border
                Grid.Column="4"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <Image
                    x:Name="ResultImage"
                    Margin="0,4,0,0"
                    RenderOptions.BitmapInterpolationMode="None"
                    Source="{Binding ResultImage, Converter={StaticResource WriteableBitmapConverter}}"
                    Stretch="Uniform" />
            </Border>

            <!-- Label Map Panel -->
            <Border
                Grid.Column="6"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsVisible="{Binding IsLabelMapExpanded}"
                Background="Transparent">
                <Image
                    Margin="0,4,0,0"
                    RenderOptions.BitmapInterpolationMode="None"
                    Source="{Binding LabelMapImage, Converter={StaticResource WriteableBitmapConverter}}"
                    Stretch="Uniform" />
            </Border>

            <!-- Load Image Buttons -->
            <elements:IconButton
                x:Name="BtnLoad1"
                Grid.Row="1"
                Grid.Column="0"
                Classes="outlined"
                Margin="10,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ap:MouseOverInfoAP.InfoText="Load Texture 1 from the current selection"
                Icon="{StaticResource image_copy}"
                Command="{Binding LoadImage1Command}" />

            <elements:IconButton
                x:Name="BtnLoad2"
                Grid.Row="1"
                Grid.Column="2"
                Classes="outlined"
                Margin="10,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ap:MouseOverInfoAP.InfoText="Load Texture 2 from the current selection"
                Icon="{StaticResource image_copy}"
                Command="{Binding LoadImage2Command}" />
        </Grid>

        <!-- UI Layout Adjuster: Splitter -->
        <GridSplitter
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="4"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Left"
            Background="Transparent"
            ResizeDirection="Columns" />

        <!-- ========================================================================= -->
        <!-- RIGHT PANEL: CONFIGURATION & PARAMETERS                                   -->
        <!-- ========================================================================= -->
        <Grid
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="10,2,10,10"
            RowDefinitions="*">

            <!-- Smooth mode: Hardness / Widening / Shift sliders -->
            <StackPanel
                Grid.Row="0"
                IsVisible="{Binding IsSmoothMode}">

                <!-- Hardness Slider -->
                <DockPanel
                    ap:MouseOverInfoAP.InfoText="Hardness: 0 = soft gradient blend, 1 = hard sharp edge">
                    <Path
                        VerticalAlignment="Center"
                        StrokeThickness="1"
                        Stroke="{DynamicResource IconFillBrush}"
                        Width="14"
                        Height="24"
                        Margin="-5,0,5,0"
                        Data="{StaticResource hardness_soft}" />
                    <Path
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Margin="-5,0,5,0"
                        StrokeThickness="1"
                        Stroke="{DynamicResource IconFillBrush}"
                        Width="14"
                        Height="20"
                        Data="{StaticResource hardness_sharp}" />
                    <elements:MouseWheelSlider
                        Margin="5,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding BlendHardnessValue}"
                        Maximum="1"
                        Minimum="0"
                        SmallChange="0.01"
                        Value="{Binding BlendHardnessValue}" />
                </DockPanel>

                <!-- Widening Slider -->
                <DockPanel
                    ap:MouseOverInfoAP.InfoText="Widening: At 0, the transition starts as a point and becomes a wider plateau as values approach 1.">
                    <Grid
                        VerticalAlignment="Top"
                        Margin="-5,11,8,0"
                        DockPanel.Dock="Left">
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource IconFillBrush}"
                            StrokeThickness="1"
                            Fill="Transparent"
                            Width="10"
                            Height="10"
                            Data="{StaticResource pivot_low}" />
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource IconFillBrush}"
                            StrokeDashArray="2,2"
                            StrokeThickness="1"
                            Fill="Transparent"
                            Width="10"
                            Height="10"
                            Data="{StaticResource pivot_high}" />
                    </Grid>
                    <Grid
                        VerticalAlignment="Top"
                        Margin="-5,11,8,0"
                        DockPanel.Dock="Right">
                        <Path
                            VerticalAlignment="Bottom"
                            StrokeThickness="1"
                            Stroke="{DynamicResource IconFillBrush}"
                            StrokeDashArray="2,2"
                            Fill="Transparent"
                            Width="10"
                            Height="10"
                            Data="{StaticResource pivot_high}" />
                        <Path
                            VerticalAlignment="Bottom"
                            StrokeThickness="1"
                            Stroke="{DynamicResource IconFillBrush}"
                            Fill="Transparent"
                            Width="10"
                            Height="10"
                            Data="{StaticResource pivot_widening}" />
                    </Grid>
                    <elements:MouseWheelSlider
                        Margin="5,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding WideningValue}"
                        Maximum="1"
                        Minimum="0"
                        SmallChange="0.01"
                        Value="{Binding WideningValue}" />
                </DockPanel>

                <!-- Shift Slider -->
                <DockPanel
                    ap:MouseOverInfoAP.InfoText="Shift: moves the transition front point or plateau left (negative) or right (positive)">
                    <Grid
                        VerticalAlignment="Top"
                        Margin="-5,11,8,0"
                        DockPanel.Dock="Left">
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource IconFillBrush}"
                            StrokeDashArray="2,2"
                            StrokeThickness="1"
                            Fill="Transparent"
                            Width="10"
                            Height="10"
                            Data="{StaticResource pivot_high}" />
                        <Path
                            VerticalAlignment="Bottom"
                            StrokeThickness="1"
                            Stroke="{DynamicResource IconFillBrush}"
                            Fill="Transparent"
                            Width="10"
                            Height="10"
                            Data="{StaticResource pivot_shift_left}" />
                    </Grid>
                    <Grid
                        VerticalAlignment="Top"
                        Margin="-5,11,8,0"
                        DockPanel.Dock="Right">
                        <Path
                            VerticalAlignment="Bottom"
                            StrokeThickness="1"
                            Stroke="{DynamicResource IconFillBrush}"
                            StrokeDashArray="2,2"
                            Fill="Transparent"
                            Width="10"
                            Height="10"
                            Data="{StaticResource pivot_high}" />
                        <Path
                            VerticalAlignment="Bottom"
                            StrokeThickness="1"
                            Stroke="{DynamicResource IconFillBrush}"
                            Fill="Transparent"
                            Width="10"
                            Height="10"
                            Data="{StaticResource pivot_shift_right}" />
                    </Grid>
                    <elements:MouseWheelSlider
                        Margin="5,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding ShiftValue}"
                        Maximum="1"
                        Minimum="-1"
                        SmallChange="0.01"
                        Value="{Binding ShiftValue}" />
                </DockPanel>
            </StackPanel>

            <!-- Brick mode: scrollable expanders -->
            <ScrollViewer
                Grid.Row="0"
                IsVisible="{Binding IsBrickMode}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    Spacing="8"
                    Margin="0,0,20,0">

                    <!-- Parameter Section: Image Analysis -->
                    <Expander
                        IsExpanded="True"
                        HorizontalAlignment="Stretch">
<Expander.Header>
                            <StackPanel
                                Orientation="Horizontal">

                                <TextBlock
                                    Text="Analysis"
                                    VerticalAlignment="Center"/>
                                
                                <!-- Label Map Toggle (brick mode only) -->
                                <elements:IconToggleButton
                                    x:Name="LabelMapToggle"
                                    Classes="outlined"
                                    Icon="{StaticResource map}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsBrickMode}"
                                    ap:MouseOverInfoAP.InfoText="Show/hide the segmentation label map"
                                    IsChecked="{Binding IsLabelMapExpanded}"
                                    Margin="15,0,0,0"
                                    Width="26"
                                    Height="26" />
                            </StackPanel>
                        </Expander.Header>
                        <local:TransitionWindowAnalysisUserControl />
                    </Expander>

                    <!-- Parameter Section: Pivot Boundaries -->
                    <Expander
                        Header="Pivot"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch">
                        <local:TransitionWindowPivotUserControl />
                    </Expander>

                    <!-- Parameter Section: Edge Blending -->
                    <Expander
                        Header="Edge"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch">
                        <local:TransitionWindowEdgeUserControl />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ========================================================================= -->
        <!-- BOTTOM PANEL: WINDOW CONTROLS & STATUS FOOTER                             -->
        <!-- ========================================================================= -->
        <!-- Decorative Background Frame for Footer -->
        <Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="-10,0,-10,-10"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Background="{DynamicResource StatusBarBackground}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0" />

        <!-- Form Submission Control Actions -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8"
            Margin="8">
            <Button
                Content="Apply"
                Command="{Binding ApplyCommand}" />
            <Button
                Content="Cancel"
                Command="{Binding CancelCommand}"
                CommandParameter="{Binding $parent[Window]}" />
            <Button
                Classes="accent"
                Content="OK"
                Command="{Binding OKCommand}"
                CommandParameter="{Binding $parent[Window]}" />
        </StackPanel>

    </Grid>
</elements:AsyncWindow>
