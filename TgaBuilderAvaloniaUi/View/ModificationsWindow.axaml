<elements:AsyncWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:elements="clr-namespace:TgaBuilderAvaloniaUi.Elements"
    xmlns:converters="clr-namespace:TgaBuilderAvaloniaUi.Converters"
    xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
    xmlns:ap="clr-namespace:TgaBuilderAvaloniaUi.AttachedProperties"
    x:Class="TgaBuilderAvaloniaUi.View.ModificationsWindow"
    x:DataType="viewmodel:ModificationsViewModel"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    Background="{DynamicResource WindowBackgroundGradient}"
    Foreground="{DynamicResource SystemBaseHighColor}"
    Title="Single Texture Modifications"
    Width="730"
    Height="300"
    MinWidth="460"
    MinHeight="300"
    Icon="avares://TgaBuilderAvaloniaUi/Resources/TgaBuilder_icon.ico">

    <!-- ========================================================================= -->
    <!-- WINDOW RESOURCES & CONVERTERS                                             -->
    <!-- ========================================================================= -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude
                    Source="/Styles/CheckerBrush.axaml" />
                <ResourceInclude
                    Source="/Styles/IconToggleButtonStyle.axaml" />
                <ResourceInclude
                    Source="/Styles/IconButtonStyle.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:WriteableBitmapConverter
                x:Key="WriteableBitmapConverter" />
            <converters:ColorStructToMediaColor
                x:Key="ColorStructToMediaColor" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- ========================================================================= -->
    <!-- MAIN CONTENT LAYOUT                                                       -->
    <!-- ========================================================================= -->
    <Grid
        RowDefinitions="*,60">

        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="2*"
                MinWidth="210" />
            <ColumnDefinition
                Width="*"
                MinWidth="220" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- LEFT PANEL: IMAGE PREVIEWS                                                -->
        <!-- ========================================================================= -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            ColumnDefinitions="*, 35, *"
            RowDefinitions="*,60">

            <!-- Input Image -->
            <Border
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <Grid>
                    <Viewbox
                        Stretch="Uniform"
                        Margin="10"
                        RenderOptions.BitmapInterpolationMode="None">
                        <Grid
                            Width="{Binding InputImage.PixelWidth, FallbackValue=128}"
                            Height="{Binding InputImage.PixelHeight, FallbackValue=128}">
                            <elements:CheckerRectangle
                                TileDensity="1" />
                            <Image
                                RenderOptions.BitmapInterpolationMode="None"
                                Source="{Binding InputImage, Converter={StaticResource WriteableBitmapConverter}}"
                                Stretch="Fill" />
                        </Grid>
                    </Viewbox>
                    <TextBlock
                        Text="Input Image"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        FontSize="20"
                        IsVisible="{Binding InitTextVisible}"
                        IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Arrow indicator -->
            <PathIcon
                Grid.Column="1"
                Data="{StaticResource arrow_forward}"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <!-- Result Image -->
            <Border
                Grid.Column="2"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <Image
                    RenderOptions.BitmapInterpolationMode="None"
                    Source="{Binding ResultImage, Converter={StaticResource WriteableBitmapConverter}}"
                    Stretch="Uniform" />
            </Border>

            <!-- Copy from Selection button (bottom of input image) -->
            <elements:IconButton
                Grid.Row="1"
                Grid.Column="0"
                Classes="outlined"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ap:MouseOverInfoAP.InfoText="Copy input image from the current selection"
                Icon="{StaticResource image_copy}"
                Command="{Binding LoadInputImageCommand}" />

        </Grid>

        <!-- UI Layout Adjuster: Splitter -->
        <GridSplitter
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="1"
            Width="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="Transparent"
            ResizeDirection="Columns" />

        <!-- ========================================================================= -->
        <!-- RIGHT PANEL: CONTROLS (scrollable expanders)                              -->
        <!-- ========================================================================= -->
        <ScrollViewer
            Grid.Row="0"
            Grid.Column="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Margin="10,4,4,4">
            <StackPanel
                Spacing="8"
                Margin="0,0,16,0">

                <!-- ================================================================= -->
                <!-- Expander: Basic                                                    -->
                <!-- ================================================================= -->
                <Expander
                    Header="Basic"
                    IsExpanded="True"
                    HorizontalAlignment="Stretch">
                    <StackPanel
                        Margin="4,4,4,6">

                        <!-- Exposure -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Exposure: adjusts overall brightness in photographic stops (-5 to +5)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Exp"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Exposure}"
                                Maximum="5"
                                Minimum="-5"
                                SmallChange="0.1"
                                Value="{Binding Exposure}" />
                        </DockPanel>

                        <!-- Brightness -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Brightness: shifts overall luminosity linearly (-1 to +1)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Bri"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Brightness}"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.01"
                                Value="{Binding Brightness}" />
                        </DockPanel>

                        <!-- Contrast -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Contrast: increases or reduces tonal range (-1 to +1)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Con"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Contrast}"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.01"
                                Value="{Binding Contrast}" />
                        </DockPanel>

                        <!-- Highlights -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Highlights: recovers or boosts bright tonal regions (-1 to +1)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Hi"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Highlights}"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.01"
                                Value="{Binding Highlights}" />
                        </DockPanel>

                        <!-- Shadows -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Shadows: lifts or crushes dark tonal regions (-1 to +1)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Sha"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Shadows}"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.01"
                                Value="{Binding Shadows}" />
                        </DockPanel>

                        <!-- Whites -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Whites: clips or expands the brightest point of the image (-1 to +1)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Whi"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Whites}"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.01"
                                Value="{Binding Whites}" />
                        </DockPanel>

                        <!-- Blacks -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Blacks: clips or expands the darkest point of the image (-1 to +1)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Blk"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Blacks}"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.01"
                                Value="{Binding Blacks}" />
                        </DockPanel>

                    </StackPanel>
                </Expander>

                <!-- ================================================================= -->
                <!-- Expander: Color                                                    -->
                <!-- ================================================================= -->
                <Expander
                    Header="Color"
                    IsExpanded="True"
                    HorizontalAlignment="Stretch">
                    <StackPanel
                        Spacing="4"
                        Margin="4,4,4,6">

                        <!-- Saturation -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Saturation: uniform increase or decrease of color intensity (-1 to +1)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Sat"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Saturation}"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.01"
                                Value="{Binding Saturation}" />
                        </DockPanel>

                        <!-- Vibrance -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Vibrance: smart saturation that boosts muted colors while protecting already-saturated ones (-1 to +1)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Vib"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Vibrance}"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.01"
                                Value="{Binding Vibrance}" />
                        </DockPanel>

                        <!-- Hue -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Hue: rotates all colors around the color wheel (-180 to +180 degrees)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Hue"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Hue}"
                                Maximum="180"
                                Minimum="-180"
                                SmallChange="1"
                                Value="{Binding Hue}" />
                        </DockPanel>

                        <!-- Temperature / Warmth -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Temperature / Warmth: negative = cooler (blue tones), positive = warmer (orange tones) (-1 to +1)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Tmp"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Temperature}"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.01"
                                Value="{Binding Temperature}" />
                        </DockPanel>

                        <!-- Tint -->
                        <DockPanel
                            ap:MouseOverInfoAP.InfoText="Tint: negative = green, positive = magenta (-1 to +1)">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Tnt"
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="11" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="+"
                                Width="12"
                                VerticalAlignment="Center"
                                FontSize="11"
                                HorizontalAlignment="Right" />
                            <elements:MouseWheelSlider
                                Margin="4,-10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Tint}"
                                Maximum="1"
                                Minimum="-1"
                                SmallChange="0.01"
                                Value="{Binding Tint}" />
                        </DockPanel>

                        <!-- Color pickers: Overlay + Target -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,4,0,0">
                            <ColorPicker
                                ap:MouseOverInfoAP.InfoText="Color Overlay: source color for color grading operations"
                                Color="{Binding ColorOverlay, Converter={StaticResource ColorStructToMediaColor}, Mode=TwoWay}" />
                            <ColorPicker
                                ap:MouseOverInfoAP.InfoText="Color Target: target color for color grading operations"
                                Color="{Binding ColorTarget, Converter={StaticResource ColorStructToMediaColor}, Mode=TwoWay}" />
                        </StackPanel>

                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- BOTTOM BAR: DECORATIVE BACKGROUND                                         -->
        <!-- ========================================================================= -->
        <Border
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="-10,0,-10,-10"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Background="{DynamicResource StatusBarBackground}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0" />

        <!-- Form Submission Control Actions -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8"
            Margin="8">
            <Button
                Content="Apply"
                Command="{Binding ApplyCommand}" />
            <Button
                Content="Cancel"
                Command="{Binding CancelCommand}"
                CommandParameter="{Binding $parent[Window]}" />
            <Button
                Classes="accent"
                Content="OK"
                Command="{Binding OKCommand}"
                CommandParameter="{Binding $parent[Window]}" />
        </StackPanel>

    </Grid>
</elements:AsyncWindow>
