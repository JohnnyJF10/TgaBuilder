<elements:AsyncWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:elements="clr-namespace:TgaBuilderAvaloniaUi.Elements"
    xmlns:converters="clr-namespace:TgaBuilderAvaloniaUi.Converters"
    xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
    xmlns:ap="clr-namespace:TgaBuilderAvaloniaUi.AttachedProperties"
    xmlns:local="clr-namespace:TgaBuilderAvaloniaUi.View"
    x:Class="TgaBuilderAvaloniaUi.View.ModificationsWindow"
    x:DataType="viewmodel:ModificationsViewModel"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    Background="{DynamicResource WindowBackgroundGradient}"
    Foreground="{DynamicResource SystemBaseHighColor}"
    Title="Single Texture Modifications"
    Width="730"
    Height="300"
    MinWidth="460"
    MinHeight="300"
    Icon="avares://TgaBuilderAvaloniaUi/Resources/TgaBuilder_icon.ico">

    <!-- ========================================================================= -->
    <!-- WINDOW RESOURCES & CONVERTERS                                             -->
    <!-- ========================================================================= -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude
                    Source="/Styles/CheckerBrush.axaml" />
                <ResourceInclude
                    Source="/Styles/IconToggleButtonStyle.axaml" />
                <ResourceInclude
                    Source="/Styles/IconButtonStyle.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:WriteableBitmapConverter
                x:Key="WriteableBitmapConverter" />
            <converters:ColorStructToMediaColor
                x:Key="ColorStructToMediaColor" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- ========================================================================= -->
    <!-- MAIN CONTENT LAYOUT                                                       -->
    <!-- ========================================================================= -->
    <Grid
        RowDefinitions="*,60">

        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="2*"
                MinWidth="210" />
            <ColumnDefinition
                Width="*"
                MinWidth="220" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- LEFT PANEL: IMAGE PREVIEWS                                                -->
        <!-- ========================================================================= -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            ColumnDefinitions="*, 35, *"
            RowDefinitions="*,60">

            <!-- Input Image -->
            <Border
                DataContext="{Binding ModificationInVM}"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <Grid>
                    <Viewbox
                        Stretch="Uniform"
                        Margin="10"
                        RenderOptions.BitmapInterpolationMode="None">
                        <Grid
                            Width="{Binding ImageIn.PixelWidth, FallbackValue=128}"
                            Height="{Binding ImageIn.PixelHeight, FallbackValue=128}">
                            <elements:CheckerRectangle
                                TileDensity="1" />
                            <Image
                                x:Name="InputImage"
                                RenderOptions.BitmapInterpolationMode="None"
                                Source="{Binding ImageIn, Converter={StaticResource WriteableBitmapConverter}}"
                                Stretch="Fill"
                                PointerMoved="InputImage_PointerMoved"
                                PointerEntered="InputImage_PointerEntered"
                                PointerExited="InputImage_PointerExited"
                                PointerPressed="InputImage_PointerPressed" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Arrow indicator -->
            <PathIcon
                Grid.Column="1"
                Data="{StaticResource arrow_forward}"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <!-- Result Image -->
            <Border
                DataContext="{Binding ModificationOutVM}"
                Grid.Column="2"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <Image
                    x:Name="ResultImage"
                    RenderOptions.BitmapInterpolationMode="None"
                    Source="{Binding ImageOut, Converter={StaticResource WriteableBitmapConverter}}"
                    Stretch="Uniform" />
            </Border>

            <!-- Copy from Selection button (bottom of input image) -->
            <elements:IconButton
                Grid.Row="1"
                Grid.Column="0"
                Classes="outlined"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ap:MouseOverInfoAP.InfoText="Copy input image from the current selection"
                Icon="{StaticResource image_copy}"
                Command="{Binding LoadImageInCommand}" />

        </Grid>

        <!-- UI Layout Adjuster: Splitter -->
        <GridSplitter
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="1"
            Width="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="Transparent"
            ResizeDirection="Columns" />

        <!-- ========================================================================= -->
        <!-- RIGHT PANEL: CONTROLS (scrollable expanders)                              -->
        <!-- ========================================================================= -->
        <ScrollViewer
            Grid.Row="0"
            Grid.Column="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Margin="10,4,4,4">
            <StackPanel
                Spacing="8"
                Margin="0,0,16,0">

                <!-- ================================================================= -->
                <!-- Expander: Basic                                                    -->
                <!-- ================================================================= -->
                <Expander
                    DataContext="{Binding BasicVM}"
                    Header="Basic"
                    IsExpanded="True"
                    HorizontalAlignment="Stretch">
                    <local:ModificationsWindowBasicUserControl />
                </Expander>

                <!-- ================================================================= -->
                <!-- Expander: Color                                                    -->
                <!-- ================================================================= -->
                <Expander
                    DataContext="{Binding ColorVM}"
                    Header="Color"
                    IsExpanded="True"
                    HorizontalAlignment="Stretch">
                    <local:ModificationsWindowColorUserControl />
                </Expander>

                <!-- ================================================================= -->
                <!-- Expander: Color Overlay                                            -->
                <!-- ================================================================= -->
                <Expander
                    DataContext="{Binding ColorOverlayVM}"
                    Header="Color Overlay"
                    IsExpanded="True"
                    HorizontalAlignment="Stretch">
                    <local:ModificationsWindowColorOverlayUserControl />
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- BOTTOM BAR: DECORATIVE BACKGROUND                                         -->
        <!-- ========================================================================= -->
        <Border
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="-10,0,-10,-10"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Background="{DynamicResource StatusBarBackground}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0" />

        <!-- Form Submission Control Actions -->
        <StackPanel
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8"
            Margin="8">
            <Button Width="80" Height="32" HorizontalContentAlignment="Center"
                Content="Apply"
                Command="{Binding ApplyCommand}" />
            <Button Width="80" Height="32" HorizontalContentAlignment="Center"
                Content="Cancel"
                Command="{Binding CancelCommand}"
                CommandParameter="{Binding $parent[Window]}" />
            <Button Width="80" Height="32" HorizontalContentAlignment="Center"
                Classes="accent"
                Content="OK"
                Command="{Binding OKCommand}"
                CommandParameter="{Binding $parent[Window]}" />
        </StackPanel>

    </Grid>
</elements:AsyncWindow>
