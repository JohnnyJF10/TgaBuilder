<UserControl x:Class="TgaBuilderAvaloniaUi.View.ModificationsWindowColorOverrideUserControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:elements="clr-namespace:TgaBuilderAvaloniaUi.Elements"
             xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
             xmlns:ap="clr-namespace:TgaBuilderAvaloniaUi.AttachedProperties"
             x:DataType="viewmodel:ColorOverrideViewModel"
             x:CompileBindings="False">

    <StackPanel
        Spacing="4"
        Margin="4,4,4,6">

        <TextBlock
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            FontSize="11"
            Text="Replaces the colour of the input texture with the colour of the secondary input while keeping the original detail. Toggle the section, then load a secondary texture."
            Margin="0,0,0,2" />

        <!-- Amount: master strength of the whole effect -->
        <DockPanel
            Margin="0,6,0,0"
            ap:MouseOverInfoAP.InfoText="Amount: overall strength of the colour override (0 = original texture, 100 = fully re-coloured).">
            <Path
                VerticalAlignment="Center"
                Fill="{DynamicResource IconFillBrush}"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Margin="5,0,0,0"
                Data="{StaticResource color_background}" />
            <Path
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Fill="{DynamicResource IconFillBrush}"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Data="{StaticResource color_background_accent}" />
            <elements:MouseWheelSlider
                Margin="4,-10"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding AmountPercent}"
                Maximum="100"
                Minimum="0"
                SmallChange="1"
                Value="{Binding AmountPercent}" />
        </DockPanel>

        <!-- Decolorize: remove the original texture's own colour -->
        <DockPanel
            Margin="0,4,0,0"
            ap:MouseOverInfoAP.InfoText="Remove original colour: fades the input texture toward greyscale before the new colour is applied (100 = fully neutral base).">
            <Path
                VerticalAlignment="Center"
                Fill="{DynamicResource IconFillBrush}"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Margin="5,0,0,0"
                Data="{StaticResource color_fill}" />
            <Path
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Fill="{DynamicResource IconFillBrush}"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Data="{StaticResource color_fill_accent}" />
            <elements:MouseWheelSlider
                Margin="4,-10"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding DecolorizePercent}"
                Maximum="100"
                Minimum="0"
                SmallChange="1"
                Value="{Binding DecolorizePercent}" />
        </DockPanel>

        <!-- Transfer: apply the secondary input's colour -->
        <DockPanel
            Margin="0,4,0,0"
            ap:MouseOverInfoAP.InfoText="Apply secondary colour: how strongly the colour of the secondary input is transferred onto the texture.">
            <Path
                VerticalAlignment="Center"
                Fill="{DynamicResource IconFillBrush}"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Margin="5,0,0,0"
                Data="{StaticResource color_line}" />
            <Path
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Fill="{DynamicResource IconFillBrush}"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Data="{StaticResource color_line_accent}" />
            <elements:MouseWheelSlider
                Margin="4,-10"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding TransferPercent}"
                Maximum="100"
                Minimum="0"
                SmallChange="1"
                Value="{Binding TransferPercent}" />
        </DockPanel>

        <!-- Smoothing: filter (blur) the secondary colour field -->
        <DockPanel
            Margin="0,4,0,0"
            ap:MouseOverInfoAP.InfoText="Filtering: blurs the colour taken from the secondary input. Low keeps specific local colours, high transfers an overall averaged tone.">
            <Path
                VerticalAlignment="Center"
                Fill="{DynamicResource IconFillBrush}"
                Width="14"
                Height="6"
                Stretch="Uniform"
                Margin="5,0,0,0"
                Data="{StaticResource circle_small}" />
            <Path
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Fill="{DynamicResource IconFillBrush}"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Data="{StaticResource circle}" />
            <elements:MouseWheelSlider
                Margin="4,-10"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding Smoothing}"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                Maximum="32"
                Minimum="0"
                SmallChange="1"
                Value="{Binding Smoothing}" />
        </DockPanel>

        <!-- Chroma Restore: restore / boost colour in the coloured regions -->
        <DockPanel
            Margin="0,4,0,0"
            ap:MouseOverInfoAP.InfoText="Restore colour: scales the resulting colour intensity to restore or boost colour in the coloured regions (100 = unchanged, 200 = double).">
            <Path
                VerticalAlignment="Center"
                Fill="{DynamicResource IconFillBrush}"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Margin="5,0,0,0"
                Data="{StaticResource dark_theme}" />
            <Path
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Fill="{DynamicResource IconFillBrush}"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Data="{StaticResource data_sunburst}" />
            <elements:MouseWheelSlider
                Margin="4,-10"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding ChromaRestorePercent}"
                Maximum="200"
                Minimum="0"
                SmallChange="1"
                Value="{Binding ChromaRestorePercent}" />
        </DockPanel>
    </StackPanel>
</UserControl>
