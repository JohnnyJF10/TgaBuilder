<UserControl x:Class="TgaBuilderAvaloniaUi.View.TransitionWindowUnderfillingUserControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:elements="clr-namespace:TgaBuilderAvaloniaUi.Elements"
             xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
             xmlns:ap="clr-namespace:TgaBuilderAvaloniaUi.AttachedProperties"
             x:DataType="viewmodel:TransitionViewModel"
             x:CompileBindings="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/IconToggleButtonStyle.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8,6,8,8">
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,8">
            <elements:IconToggleButton
                Classes="outlined"
                VerticalAlignment="Center"
                MinHeight="36"
                MinWidth="36"
                Icon="{StaticResource camera_switch}"
                ap:MouseOverInfoAP.InfoText="Turn the underfilling into an overfilling by substituting brigth pixes instead, possible for sandy textures and bright backgrounds"
                IsChecked="{Binding ReverseUnderfilling}" />
        </StackPanel>

        <DockPanel Margin="0,0,0,8"
                   ap:MouseOverInfoAP.InfoText="Underfilling Threshold: 0 = no underfilling, 255 = maximum underfilling">
            <Path
                Fill="{DynamicResource IconFillBrush}"
                Data="{StaticResource tab_prohibited}"
                Width="16"
                Height="16"
                VerticalAlignment="Center" />
            <Path
                Fill="{DynamicResource IconFillBrush}"
                Data="{StaticResource tab_in_private}"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                DockPanel.Dock="Right" />
            <elements:MouseWheelSlider
                Margin="5,0"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding UnderfillingThreshold}"
                Maximum="255"
                Minimum="0"
                SmallChange="1"
                Value="{Binding UnderfillingThreshold}" />
        </DockPanel>

        <DockPanel Margin="0,8,0,0"
                   ap:MouseOverInfoAP.InfoText="Pivot: sets the position of the transition border (0 = left, 1 = right)">
            <Grid
                VerticalAlignment="Top"
                Margin="0,11,8,0"
                DockPanel.Dock="Left">
                <Path
                    VerticalAlignment="Bottom"
                    Stroke="{DynamicResource IconFillBrush}"
                    StrokeThickness="1"
                    Fill="Transparent"
                    Width="10"
                    Height="10"
                    Data="{StaticResource pivot_low}" />
                <Path
                    VerticalAlignment="Bottom"
                    Stroke="{DynamicResource IconFillBrush}"
                    StrokeDashArray="2,2"
                    StrokeThickness="1"
                    Fill="Transparent"
                    Width="10"
                    Height="10"
                    Data="{StaticResource pivot_high}" />
            </Grid>
            <Grid
                VerticalAlignment="Top"
                Margin="-5,11,8,0"
                DockPanel.Dock="Right">
                <Path
                    VerticalAlignment="Bottom"
                    StrokeThickness="1"
                    Stroke="{DynamicResource IconFillBrush}"
                    Fill="Transparent"
                    Width="10"
                    Height="10"
                    Data="{StaticResource pivot_high}" />
                <Path
                    VerticalAlignment="Bottom"
                    StrokeThickness="1"
                    Stroke="{DynamicResource IconFillBrush}"
                    StrokeDashArray="2,2"
                    Fill="Transparent"
                    Width="10"
                    Height="10"
                    Data="{StaticResource pivot_low}" />
            </Grid>
            <elements:MouseWheelSlider
                Margin="5,0"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding UnderfillingPivot}"
                Maximum="1"
                Minimum="0"
                SmallChange="0.01"
                ap:MouseOverInfoAP.InfoText="Underfilling pivot: sets the position of the underfilling area (0 = left, 1 = right)"
                Value="{Binding UnderfillingPivot}" />
        </DockPanel>
    </StackPanel>
</UserControl>
