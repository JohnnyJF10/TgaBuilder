<elements:AsyncWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:TgaBuilderWpfUi.View"
    xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:elements="clr-namespace:TgaBuilderWpfUi.Elements"
    xmlns:ap="clr-namespace:TgaBuilderWpfUi.AttachedProperties"
    xmlns:converters="clr-namespace:TgaBuilderWpfUi.Converters"
    xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker"
    x:Class="TgaBuilderWpfUi.View.TransitionWindow"
    mc:Ignorable="d"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Title="MainWindow"
    Width="730"
    Height="300"
    MinWidth="730"
    MinHeight="300"
    d:Background="Black"
    d:DataContext="{d:DesignInstance Type=viewmodel:TransitionViewModel, IsDesignTimeCreatable=False}">

    <!-- ========================================================================= -->
    <!-- WINDOW RESOURCES                                                          -->
    <!-- ========================================================================= -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/Styles/ModifiedUiNumberBoxStyle.xaml" />
                <ResourceDictionary
                    Source="/Styles/TitleBarNavigationAreaStyle.xaml" />
                <ResourceDictionary
                    Source="/Styles/CheckerBrush.xaml" />
                <ResourceDictionary
                    Source="/Styles/MouseWheelSliderStyle.xaml" />
                <ResourceDictionary
                    Source="/Styles/TabControlStyles.xaml" />
                <ResourceDictionary
                    Source="/Styles/ToggleButtonExStyle.xaml" />
                <ResourceDictionary
                    Source="/Styles/IconRadioButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter
                x:Key="BoolToVisibilityConverter" />
            <converters:WriteableBitmapConverter
                x:Key="WriteableBitmapConverter" />
            <converters:ColorStructToMediaColorConverter
                x:Key="ColorStructToMediaColorConverter" />
            <converters:EnumToBooleanConverter
                x:Key="EnumToBooleanConverter" />
            <sys:Boolean
                x:Key="True">True</sys:Boolean>
            <sys:Boolean
                x:Key="False">False</sys:Boolean>
            <Style
                TargetType="{x:Type elements:ContextMenuButton}"
                BasedOn="{StaticResource {x:Type ui:Button}}" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- ========================================================================= -->
    <!-- MAIN WINDOW LAYOUT                                                        -->
    <!-- ========================================================================= -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="3*"
                MinWidth="420" />
            <ColumnDefinition
                Width="Auto" />
            <ColumnDefinition
                Width="*"
                MinWidth="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="60" />
        </Grid.RowDefinitions>

        <!-- Row 0: WPF title/menu bar -->
        <DockPanel
            Grid.Row="0"
            Grid.ColumnSpan="3">
            <ui:TitleBar
                DockPanel.Dock="Right"
                Width="133"
                Style="{StaticResource TitleBarNavigationAreaStyle}" />
            <ui:TitleBar
                Title="Transition Helper"
                ShowMinimize="False"
                ShowMaximize="False"
                ShowClose="False"
                Margin="3,3,0,0">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon
                        Source="pack://application:,,,/Resources/TgaBuilder_picture.png" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>
        </DockPanel>

        <!-- Decorative card background for the bottom area -->
            <ui:Card
            Grid.Row="3"
            Grid.ColumnSpan="3"
            Margin="-10,0,-10,-10"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False" />

        <!-- Left pane: image workflow and optional label map -->
        <Grid
            x:Name="ImageAreaGrid"
            Grid.Row="2"
            Grid.Column="0"
            Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="35" />
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="35" />
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style
                            TargetType="ColumnDefinition">
                            <Setter
                                Property="Width"
                                Value="0" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsChecked, ElementName=LabelMapToggle}"
                                    Value="True">
                                    <Setter
                                        Property="Width"
                                        Value="*" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="*" />
                <RowDefinition
                    Height="60" />
            </Grid.RowDefinitions>

            <!-- Source Image 1 -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AllowDrop="True"
                Background="Transparent">
                <Grid>
                    <Viewbox
                        Stretch="Uniform"
                        Margin="10"
                        RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Grid
                            Width="{Binding Image1.PixelWidth, FallbackValue=128}"
                            Height="{Binding Image1.PixelHeight, FallbackValue=128}">
                            <Rectangle
                                Fill="{StaticResource CheckerBrush}" />
                            <Image
                                x:Name="Image1"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding Image1, Converter={StaticResource WriteableBitmapConverter}}"
                                Stretch="Fill"
                                MouseMove="Image1_MouseMove"
                                MouseEnter="Image1_MouseEnter"
                                MouseLeave="Image1_MouseLeave"
                                MouseDown="Image1_MouseDown" />
                        </Grid>
                    </Viewbox>
                    <TextBlock
                        Text="Texture 1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        d:Foreground="White"
                        FontSize="18"
                        Visibility="{Binding InitTextVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Swap Controls -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                Margin="0,38,0,0">
                <ui:SymbolIcon
                    Symbol="Add24"
                    d:Foreground="White" />
                <ui:Button
                    Width="30"
                    Height="30"
                    Padding="5"
                    HorizontalAlignment="Center"
                    Icon="{ui:SymbolIcon ArrowSwap24}"
                    Margin="0,9,0,0"
                    ap:MouseOverInfoAP.InfoText="Swap Texture 1 and Texture 2"
                    Command="{Binding SwapImagesCommand}" />
            </StackPanel>

            <!-- Source Image 2 -->
            <Border
                Grid.Row="0"
                Grid.Column="2"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AllowDrop="True"
                Background="Transparent">
                <Grid>
                    <Viewbox
                        Stretch="Uniform"
                        RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Grid
                            Width="{Binding Image2.PixelWidth, FallbackValue=128}"
                            Height="{Binding Image2.PixelHeight, FallbackValue=128}">
                            <Rectangle
                                Fill="{StaticResource CheckerBrush}" />
                            <Image
                                x:Name="Image2"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding Image2, Converter={StaticResource WriteableBitmapConverter}}"
                                Stretch="Fill"
                                MouseMove="Image2_MouseMove"
                                MouseEnter="Image2_MouseEnter"
                                MouseLeave="Image2_MouseLeave"
                                MouseDown="Image2_MouseDown" />
                        </Grid>
                    </Viewbox>
                    <TextBlock
                        Text="Texture 2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        d:Foreground="White"
                        FontSize="18"
                        Visibility="{Binding InitTextVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Mix Command Arrow -->
            <ui:Button
                x:Name="BtnResult"
                Grid.Row="0"
                Grid.Column="3"
                Appearance="Primary"
                Foreground="White"
                Width="30"
                Height="30"
                Padding="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ap:MouseOverInfoAP.InfoText="Generate the transition result image"
                Command="{Binding MixCommand}"
                Icon="{ui:SymbolIcon ArrowRight24}" />

            <!-- Result Image -->
            <Border
                Grid.Row="0"
                Grid.Column="4"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AllowDrop="True"
                Background="Transparent">
                <Grid>
                    <Viewbox
                        Stretch="Uniform"
                        RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Grid
                            Width="{Binding Image2.PixelWidth, FallbackValue=128}"
                            Height="{Binding Image2.PixelHeight, FallbackValue=128}">
                            <Image
                                x:Name="ResultImage"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding ResultImage, Converter={StaticResource WriteableBitmapConverter}}"
                                Stretch="Uniform" 
                                MouseMove="ResultImage_MouseMove"
                                MouseEnter="ResultImage_MouseEnter"
                                MouseLeave="ResultImage_MouseLeave"
                                MouseDown="ResultImage_MouseDown"/>
                            <Image
                                x:Name="IndicatorImage"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsIndicatorMapVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                Source="{Binding IndicatorMapImage, Converter={StaticResource WriteableBitmapConverter}}"
                                Stretch="Uniform" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Label Map Panel -->
            <Border
                Grid.Row="0"
                Grid.Column="6"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{Binding IsLabelMapExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="Transparent">
                <Image
                    Margin="0,4,0,0"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    Source="{Binding LabelMapImage, Converter={StaticResource WriteableBitmapConverter}}"
                    Stretch="Uniform" />
            </Border>

            <!-- Load Image Buttons -->
            <ui:Button
                x:Name="BtnLoad1"
                Width="30"
                Height="30"
                Grid.Row="1"
                Grid.Column="0"
                Margin="10,5"
                Padding="5"
                HorizontalAlignment="Center"
                ap:MouseOverInfoAP.InfoText="Load Texture 1 from the current selection"
                Icon="{ui:SymbolIcon ImageCopy24}"
                Command="{Binding LoadImage1Command}"
                CommandParameter="1" />
            <ui:Button
                x:Name="BtnLoad2"
                Width="30"
                Height="30"
                Grid.Row="1"
                Grid.Column="2"
                Margin="10,5"
                Padding="5"
                HorizontalAlignment="Center"
                ap:MouseOverInfoAP.InfoText="Load Texture 2 from the current selection"
                Icon="{ui:SymbolIcon ImageCopy24}"
                Command="{Binding LoadImage2Command}"
                CommandParameter="2" />
        </Grid>

        <local:TransitionWindowControlsUserControl
            Grid.Row="1" />

        <!-- Between panes: column splitter -->
        <GridSplitter
            Grid.Row="2"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="4"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Center"
            Background="Transparent"
            ResizeDirection="Columns" />

        <!-- ========================================================================= -->
        <!-- RIGHT PANEL: CONFIGURATION & PARAMETERS                                   -->
        <!-- ========================================================================= -->
        <Grid
            Grid.Row="1"
            Grid.Column="2"
            Grid.RowSpan="2"
            Margin="10,0,10,10">

            <!-- Smooth mode: Hardness / Widening / Shift sliders -->
            <local:TransitionWindowSmoothUserControl
                DataContext="{Binding PivotSmooth}"
                Visibility="{Binding DataContext.IsSmoothMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Brick mode: scrollable expanders -->
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding IsBrickMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel
                    Margin="0,0,12,0">

                    <!-- Parameter Section: Image Analysis -->
                    <Expander
                        IsExpanded="True"
                        HorizontalAlignment="Stretch">
<Expander.Header>
                            <StackPanel
                                Orientation="Horizontal">
                                <TextBlock
                                    Text="Analysis"
                                    d:Foreground="White"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <!-- Label Map Toggle (brick mode only) -->
                                <elements:ToggleButtonEx
                                    x:Name="LabelMapToggle"
                                    ap:MouseOverInfoAP.InfoText="Show/hide the segmentation label map"
                                    IsChecked="{Binding IsLabelMapExpanded}"
                                    Icon="{ui:SymbolIcon Map20}"
                                    Width="30"
                                    Height="30"
                                    Margin="10,-10,0,-10"
                                    Padding="0"/>
                            </StackPanel>
                        </Expander.Header>
                        <local:TransitionWindowAnalysisUserControl DataContext="{Binding Analysis}" />
                    </Expander>

                    <!-- Parameter Section: Pivot Boundaries -->
                    <Expander
                        Header="Pivot"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0">
                        <local:TransitionWindowPivotUserControl DataContext="{Binding PivotBricks}" />
                    </Expander>

                    <!-- Parameter Section: Edge Blending -->
                    <Expander
                        Header="Edge"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0">
                        <local:TransitionWindowEdgeUserControl DataContext="{Binding Edge}" />
                    </Expander>

                    <!-- Parameter Section: Shadow -->
                    <Expander
                        Header="Shadow"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0">
                        <local:TransitionWindowShadowUserControl DataContext="{Binding Shadow}" />
                    </Expander>

                    <!-- Parameter Section: Underfilling -->
                    <Expander
                        Header="Underfilling"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0">
                        <local:TransitionWindowUnderfillingUserControl DataContext="{Binding Underfilling}" />
                    </Expander>

                    <!-- Parameter Section: Manual -->
                    <Expander
                        Header="Manual"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0">
                        <local:TransitionWindowManualUserControl DataContext="{Binding Manual}" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Row 3: footer bar and action buttons -->

        <StackPanel
            Grid.Row="3"
            Grid.ColumnSpan="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="8">
            <ui:Button
                Width="75"
                Height="30"
                Margin="0,0,8,0"
                Content="Apply"
                Command="{Binding ApplyCommand}" />
            <ui:Button
                Width="75"
                Height="30"
                Margin="0,0,8,0"
                ap:MouseOverInfoAP.InfoText="Cancel and close the dialog"
                Command="{Binding CancelCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Content="Cancel" />
            <ui:Button
                Width="75"
                Height="30"
                Appearance="Primary"
                Foreground="White"
                ap:MouseOverInfoAP.InfoText="Apply the transition and close"
                Command="{Binding OKCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Content="OK" />
        </StackPanel>
    </Grid>
</elements:AsyncWindow>
