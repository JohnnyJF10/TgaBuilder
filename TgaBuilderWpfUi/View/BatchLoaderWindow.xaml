<elements:AsyncWindow
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="TgaBuilderWpfUi.View.BatchLoaderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:TgaBuilderWpfUi.View"
    xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:wpfzoompanel="clr-namespace:WPFZoomPanel;assembly=WPF.ZoomPanel"
    xmlns:elements="clr-namespace:TgaBuilderWpfUi.Elements"
    xmlns:ap="clr-namespace:TgaBuilderWpfUi.AttachedProperties"
    xmlns:converters="clr-namespace:TgaBuilderWpfUi.Converters"
    mc:Ignorable="d"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Title="MainWindow"
    Height="550"
    MinHeight="550"
    Width="780"
    MinWidth="700"
    d:Background="Black"
    d:DataContext="{d:DesignInstance Type=viewmodel:BatchLoaderViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ModifiedUiNumberBoxStyle.xaml"/>
                <ResourceDictionary Source="/Styles/TitleBarNavigationAreaStyle.xaml"/>
                <ResourceDictionary Source="/Styles/CheckerBrush.xaml"/>
                <ResourceDictionary Source="/Styles/MouseWheelSliderStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:WriteableBitmapConverter x:Key="WriteableBitmapConverter"/>
            <sys:Boolean x:Key="True">True</sys:Boolean>
            <sys:Boolean x:Key="False">False</sys:Boolean>
            <Style TargetType="{x:Type elements:ContextMenuButton}" BasedOn="{StaticResource {x:Type ui:Button}}"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="3">
            <ui:TitleBar DockPanel.Dock="Right" Width="133" Style="{StaticResource TitleBarNavigationAreaStyle}"/>
            <ui:TitleBar Title="Batch File Loader" ShowMinimize="False" ShowMaximize="False" ShowClose="False" Margin="3,3,0,0" Grid.ColumnSpan="3">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Resources/TgaBuilder_picture.png" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>
        </DockPanel>

        <ui:Card Grid.Row="1" Grid.Column="0" Margin="5" IsHitTestVisible="False"/>
        <Rectangle Grid.Row="1" Grid.Column="0" Margin="5.1" Fill="{StaticResource CheckerBrush}" Width="{Binding ContentActualWidth}" Height="{Binding ContentActualHeight}" IsHitTestVisible="False"/>
        <elements:FileDropBorder Grid.Row="1" Grid.Column="0" Margin="5" DropCommand="{Binding FileDropCommand}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                <wpfzoompanel:ZoomPanel
                    BorderBrush="Transparent"
                    Background="Transparent"
                    ViewportZoom="{Binding Zoom, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    ZoomAndPanInitialPosition="FitScreen"
                    ap:SizeObserverAP.ObserveSize="True"
                    ap:SizeObserverAP.ObservedWidth="{Binding ViewportWidth, Mode=OneWayToSource}"
                    ap:SizeObserverAP.ObservedHeight="{Binding ViewportHeight, Mode=OneWayToSource}">
                    <Image Source="{Binding Presenter, Converter={StaticResource WriteableBitmapConverter}}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </wpfzoompanel:ZoomPanel>
            </ScrollViewer>
        </elements:FileDropBorder>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Drop Image Files here" Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Visibility="{Binding IsDropHintVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns"/>

        <Grid Grid.Row="1" Grid.Column="2" Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <ui:Button Content="Select Folder..." Margin="0,0,0,8" HorizontalAlignment="Stretch" Command="{Binding SelectTRRFolderCommand}" CommandParameter="{StaticResource False}"/>
                <elements:ContextMenuButton Margin="0,0,0,8" ItemsSource="{Binding RecentBatchLoaderFolders}" ItemCommand="{Binding OpenRecentFolderCommand}">
                    <TextBlock>
                        <Run Text=" Recent Folders" />
                        <Run FontFamily="Segoe UI Symbol" Text="&#xE0E5;" />
                    </TextBlock>
                </elements:ContextMenuButton>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Width="30" Height="30" Padding="5" Margin="0,0,6,0" Command="{Binding Zoom100Command}" ap:MouseOverInfoAP.InfoText="Zoom to exact pixel sized (100% zoom)" Icon="{ui:SymbolIcon ZoomFit24}"/>
                    <ui:Button Width="30" Height="30" Padding="5" Margin="0,0,6,0" Command="{Binding FillCommand}" ap:MouseOverInfoAP.InfoText="Fit to Panel Height" Icon="{ui:SymbolIcon ArrowAutofitHeight24}"/>
                    <ui:Button Width="30" Height="30" Padding="5" Command="{Binding FitCommand}" ap:MouseOverInfoAP.InfoText="Fit to Panel Width" Icon="{ui:SymbolIcon ArrowAutofitWidth24}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Label Content="First Texture Index:" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                <elements:MouseWheelNumberBox Style="{StaticResource ModifiedUiNumberBoxStyle}" Value="{Binding StartTexIndex, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Number of Textures:" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                <elements:MouseWheelNumberBox Style="{StaticResource ModifiedUiNumberBoxStyle}" Value="{Binding NumTextures, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Texture Size:" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                <elements:MouseWheelNumberBox Style="{StaticResource ModifiedUiNumberBoxStyle}" Value="{Binding TextureSize, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Import Panel Width:" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                <elements:MouseWheelNumberBox Style="{StaticResource ModifiedUiNumberBoxStyle}" Value="{Binding PanelWidth, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Scaling Mode:" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                <ComboBox SelectedIndex="{Binding ScalingModeIndex, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Linear" />
                    <ComboBoxItem Content="Fant" />
                    <ComboBoxItem Content="Near. Neigh." />
                </ComboBox>
            </StackPanel>
        </Grid>

        <ui:Card Grid.Row="2" Grid.ColumnSpan="3" Margin="-10,0,-10,-10" VerticalAlignment="Stretch" IsHitTestVisible="False"/>
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <ui:Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <ui:Button Appearance="Primary" Foreground="White" Content="OK" Width="80" Height="30" Command="{Binding ImportCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <ui:SnackbarPresenter x:Name="MessageSnackbarPresenter" d:Visibility="Hidden" Grid.ColumnSpan="3" Grid.RowSpan="3"/>
    </Grid>
</elements:AsyncWindow>
