<UserControl x:Class="TgaBuilderWpfUi.View.TransitionWindowPivotUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:elements="clr-namespace:TgaBuilderWpfUi.Elements"
             xmlns:ap="clr-namespace:TgaBuilderWpfUi.AttachedProperties"
             xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:enums="clr-namespace:TgaBuilderLib.Enums;assembly=TgaBuilderLib"
             mc:Ignorable="d">
                        <StackPanel
                            Margin="8,6,8,8">
                            <StackPanel
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                                <elements:ToggleButtonEx
                                    VerticalAlignment="Center"
                                    ap:MouseOverInfoAP.InfoText="Reverse the pivot direction"
                                    Icon="{ui:SymbolIcon FlipHorizontal24}"
                                    MinHeight="36"
                                    MinWidth="36"
                                    IsChecked="{Binding ReversePivot}" />
                                <elements:ToggleButtonEx
                                    Margin="8,0,0,0"
                                    x:Name="ProtectEdgesToggleButton"
                                    VerticalAlignment="Center"
                                    MinHeight="36"
                                    MinWidth="36"
                                    Icon="{ui:SymbolIcon Shield24}"
                                    ap:MouseOverInfoAP.InfoText="Protect Edges: Enabling ensures that tile texture bordering edges contains tiles and background bordering edges do not contain tiles."
                                    IsChecked="{Binding ProtectEdges}" />
                                <elements:ToggleButtonEx
                                    VerticalAlignment="Center"
                                    MinHeight="36"
                                    MinWidth="36"
                                    Margin="8,0,0,0"
                                    Icon="{ui:SymbolIcon Cut24}"
                                    ap:MouseOverInfoAP.InfoText="Slice Corners: enable/disable slicing of corner tiles"
                                    IsEnabled="{Binding IsChecked, ElementName=ProtectEdgesToggleButton}"
                                    IsChecked="{Binding SliceCornerTiles}" />
                            </StackPanel>

                            <DockPanel
                                ap:MouseOverInfoAP.InfoText="Widening: 0 = Adds or enlarges the plateau at the transition front until it touches the edges at value 1">
                                <Grid
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left">
                                    <Path
                                        VerticalAlignment="Bottom"
                                        Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                        d:Stroke="White"
                                        Fill="Transparent"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                        Data="{StaticResource pivot_low}" />
                                    <Path
                                        VerticalAlignment="Bottom"
                                        Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                        d:Stroke="White"
                                        StrokeDashArray="2.2"
                                        Fill="Transparent"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                        Data="{StaticResource pivot_high}" />
                                </Grid>
                                <Grid
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right">
                                    <Path
                                        VerticalAlignment="Bottom"
                                        Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                        d:Stroke="White"
                                        Fill="Transparent"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                        StrokeDashArray="2.2"
                                        Data="{StaticResource pivot_high}" />
                                    <Path
                                        VerticalAlignment="Bottom"
                                        Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                        d:Stroke="White"
                                        Fill="Transparent"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                        Data="{StaticResource pivot_widening}" />
                                </Grid>
                                <elements:MouseWheelSlider
                                    Style="{StaticResource MouseWheelSliderStyle}"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    AutoToolTipPlacement="BottomRight"
                                    AutoToolTipPrecision="2"
                                    Maximum="1"
                                    Minimum="0"
                                    SmallChange="0.01"
                                    Value="{Binding WideningValue}" />
                            </DockPanel>

                            <DockPanel
                                Margin="0,16,0,0"
                                ap:MouseOverInfoAP.InfoText="Shift: moves the transition front point or plateau left (negative) or right (positive)">
                                <Grid
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left">
                                    <Path
                                        VerticalAlignment="Bottom"
                                        Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                        d:Stroke="White"
                                        StrokeDashArray="2.2"
                                        Fill="Transparent"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                        Data="{StaticResource pivot_high}" />
                                    <Path
                                        VerticalAlignment="Bottom"
                                        Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                        d:Stroke="White"
                                        Fill="Transparent"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                        Data="{StaticResource pivot_shift_left}" />
                                </Grid>
                                <Grid
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right">
                                    <Path
                                        VerticalAlignment="Bottom"
                                        Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                        d:Stroke="White"
                                        StrokeDashArray="2.2"
                                        Fill="Transparent"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                        Data="{StaticResource pivot_high}" />
                                    <Path
                                        VerticalAlignment="Bottom"
                                        Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                        d:Stroke="White"
                                        Fill="Transparent"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                        Data="{StaticResource pivot_shift_right}" />
                                </Grid>
                                <elements:MouseWheelSlider
                                    Style="{StaticResource MouseWheelSliderStyle}"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    AutoToolTipPlacement="BottomRight"
                                    AutoToolTipPrecision="2"
                                    Maximum="1"
                                    Minimum="-1"
                                    SmallChange="0.01"
                                    Value="{Binding ShiftValue}" />
                            </DockPanel>
                        </StackPanel>
                    
</UserControl>
