<UserControl x:Class="TgaBuilderWpfUi.View.TransitionWindowPivotUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:elements="clr-namespace:TgaBuilderWpfUi.Elements"
             xmlns:ap="clr-namespace:TgaBuilderWpfUi.AttachedProperties"
             xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:enums="clr-namespace:TgaBuilderLib.Enums;assembly=TgaBuilderLib"
             xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
             d:DataContext="{d:DesignInstance Type=viewmodel:TransitionViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/MouseWheelSliderStyle.xaml" />
                <ResourceDictionary Source="/Styles/ToggleButtonExStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal">
            <elements:ToggleButtonEx
                VerticalAlignment="Center"
                MinHeight="36"
                MinWidth="36"
                Icon="{ui:SymbolIcon FlipHorizontal24}"
                ap:MouseOverInfoAP.InfoText="Reverse the pivot direction"
                IsChecked="{Binding ReversePivot}" />
            <elements:ToggleButtonEx
                x:Name="ProtectEdgesToggleButton"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                MinHeight="36"
                MinWidth="36"
                Icon="{ui:SymbolIcon Shield24}"
                ap:MouseOverInfoAP.InfoText="Protect Edges: Enabling ensures that tile texture bordering edges contains tiles and background bordering edges do not contain tiles."
                IsChecked="{Binding ProtectEdges}" />
            <elements:ToggleButtonEx
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                MinHeight="36"
                MinWidth="36"
                Icon="{ui:SymbolIcon Cut24}"
                ap:MouseOverInfoAP.InfoText="Slice Corners: enable/disable slicing of corner tiles"
                IsEnabled="{Binding IsChecked, ElementName=ProtectEdgesToggleButton}"
                IsChecked="{Binding SliceCornerTiles}" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Top"
            Margin="-5,11,8,0"
            ap:MouseOverInfoAP.InfoText="Widening: At 0, the transition starts as a point and becomes a wider plateau as values approach 1.">
            <Path
                VerticalAlignment="Bottom"
                Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                d:Stroke="White"
                StrokeThickness="1"
                Fill="Transparent"
                Width="10"
                Height="10"
                Data="{StaticResource pivot_low}" />
            <Path
                VerticalAlignment="Bottom"
                Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                d:Stroke="White"
                StrokeDashArray="2,2"
                StrokeThickness="1"
                Fill="Transparent"
                Width="10"
                Height="10"
                Data="{StaticResource pivot_high}" />
        </Grid>
        <elements:MouseWheelSlider
            Grid.Row="1"
            Grid.Column="1"
            Style="{StaticResource MouseWheelSliderStyle}"
            Margin="5,0"
            VerticalAlignment="Center"
            AutoToolTipPlacement="BottomRight"
            AutoToolTipPrecision="2"
            Maximum="1"
            Minimum="0"
            SmallChange="0.01"
            Value="{Binding WideningValue}"
            ap:MouseOverInfoAP.InfoText="Widening: At 0, the transition starts as a point and becomes a wider plateau as values approach 1." />
        <Grid
            Grid.Row="1"
            Grid.Column="2"
            VerticalAlignment="Top"
            Margin="-5,11,8,0"
            ap:MouseOverInfoAP.InfoText="Widening: At 0, the transition starts as a point and becomes a wider plateau as values approach 1.">
            <Path
                VerticalAlignment="Bottom"
                Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                d:Stroke="White"
                StrokeThickness="1"
                StrokeDashArray="2,2"
                Fill="Transparent"
                Width="10"
                Height="10"
                Data="{StaticResource pivot_high}" />
            <Path
                VerticalAlignment="Bottom"
                Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                d:Stroke="White"
                StrokeThickness="1"
                Fill="Transparent"
                Width="10"
                Height="10"
                Data="{StaticResource pivot_widening}" />
        </Grid>

        <Grid
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Top"
            Margin="-5,11,8,0"
            ap:MouseOverInfoAP.InfoText="Shift: moves the transition front point or plateau left (negative) or right (positive)">
            <Path
                VerticalAlignment="Bottom"
                Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                d:Stroke="White"
                StrokeDashArray="2,2"
                StrokeThickness="1"
                Fill="Transparent"
                Width="10"
                Height="10"
                Data="{StaticResource pivot_high}" />
            <Path
                VerticalAlignment="Bottom"
                Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                d:Stroke="White"
                StrokeThickness="1"
                Fill="Transparent"
                Width="10"
                Height="10"
                Data="{StaticResource pivot_shift_left}" />
        </Grid>
        <elements:MouseWheelSlider
            Grid.Row="2"
            Grid.Column="1"
            Style="{StaticResource MouseWheelSliderStyle}"
            Margin="5,0"
            VerticalAlignment="Center"
            AutoToolTipPlacement="BottomRight"
            AutoToolTipPrecision="2"
            Maximum="1"
            Minimum="-1"
            SmallChange="0.01"
            Value="{Binding ShiftValue}"
            ap:MouseOverInfoAP.InfoText="Shift: moves the transition front point or plateau left (negative) or right (positive)" />
        <Grid
            Grid.Row="2"
            Grid.Column="2"
            VerticalAlignment="Top"
            Margin="-5,11,8,0"
            ap:MouseOverInfoAP.InfoText="Shift: moves the transition front point or plateau left (negative) or right (positive)">
            <Path
                VerticalAlignment="Bottom"
                Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                d:Stroke="White"
                StrokeThickness="1"
                StrokeDashArray="2,2"
                Fill="Transparent"
                Width="10"
                Height="10"
                Data="{StaticResource pivot_high}" />
            <Path
                VerticalAlignment="Bottom"
                Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                d:Stroke="White"
                StrokeThickness="1"
                Fill="Transparent"
                Width="10"
                Height="10"
                Data="{StaticResource pivot_shift_right}" />
        </Grid>
    </Grid>
                    
</UserControl>
