<UserControl x:Class="TgaBuilderWpfUi.View.TransitionWindowSmoothUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:elements="clr-namespace:TgaBuilderWpfUi.Elements"
             xmlns:ap="clr-namespace:TgaBuilderWpfUi.AttachedProperties"
             xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
             d:DataContext="{d:DesignInstance Type=viewmodel:TransitionViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/MouseWheelSliderStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
            <StackPanel
                Margin="0,8,15,0"
                Visibility="{Binding TransitionsPresentersVM.IsSmoothMode, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- Hardness Slider -->
                <DockPanel
                    ap:MouseOverInfoAP.InfoText="Hardness: 0 = soft gradient blend, 1 = hard sharp edge">
                    <Path
                        DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                        d:Stroke="White"
                        Fill="Transparent"
                        Width="14"
                        Height="14"
                        Stretch="Uniform"
                        Data="{StaticResource hardness_soft}" />
                    <Path
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                        d:Stroke="White"
                        Fill="Transparent"
                        Width="14"
                        Height="14"
                        Stretch="Uniform"
                        Data="{StaticResource hardness_sharp}" />
                    <elements:MouseWheelSlider
                        Style="{StaticResource MouseWheelSliderStyle}"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        AutoToolTipPlacement="BottomRight"
                        AutoToolTipPrecision="2"
                        Maximum="1"
                        Minimum="0"
                        SmallChange="0.01"
                        Value="{Binding BlendHardnessValue}" />
                </DockPanel>

                <!-- Widening Slider -->
                <DockPanel
                    Margin="0,18,0,0"
                    ap:MouseOverInfoAP.InfoText="Widening: 0 = Adds or enlarges the plateau at the transition front until it touches the edges at value 1">
                    <Grid
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left">
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                            d:Stroke="White"
                            Fill="Transparent"
                            Width="14"
                            Height="14"
                            Stretch="Uniform"
                            Data="{StaticResource pivot_low}" />
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                            d:Stroke="White"
                            StrokeDashArray="2.2"
                            Fill="Transparent"
                            Width="14"
                            Height="14"
                            Stretch="Uniform"
                            Data="{StaticResource pivot_high}" />
                    </Grid>
                    <Grid
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right">
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                            d:Stroke="White"
                            Fill="Transparent"
                            Width="14"
                            Height="14"
                            Stretch="Uniform"
                            StrokeDashArray="2.2"
                            Data="{StaticResource pivot_high}" />
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                            d:Stroke="White"
                            Fill="Transparent"
                            Width="14"
                            Height="14"
                            Stretch="Uniform"
                            Data="{StaticResource pivot_widening}" />
                    </Grid>
                    <elements:MouseWheelSlider
                        Style="{StaticResource MouseWheelSliderStyle}"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        AutoToolTipPlacement="BottomRight"
                        AutoToolTipPrecision="2"
                        Maximum="1"
                        Minimum="0"
                        SmallChange="0.01"
                        Value="{Binding WideningValue}" />
                </DockPanel>

                <!-- Shift Slider -->
                <DockPanel
                    Margin="0,18,0,0"
                    ap:MouseOverInfoAP.InfoText="Shift: moves the transition front point or plateau left (negative) or right (positive)">
                    <Grid
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left">
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                            d:Stroke="White"
                            StrokeDashArray="2.2"
                            Fill="Transparent"
                            Width="14"
                            Height="14"
                            Stretch="Uniform"
                            Data="{StaticResource pivot_high}" />
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                            d:Stroke="White"
                            Fill="Transparent"
                            Width="14"
                            Height="14"
                            Stretch="Uniform"
                            Data="{StaticResource pivot_shift_left}" />
                    </Grid>
                    <Grid
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right">
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                            d:Stroke="White"
                            StrokeDashArray="2.2"
                            Fill="Transparent"
                            Width="14"
                            Height="14"
                            Stretch="Uniform"
                            Data="{StaticResource pivot_high}" />
                        <Path
                            VerticalAlignment="Bottom"
                            Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                            d:Stroke="White"
                            Fill="Transparent"
                            Width="14"
                            Height="14"
                            Stretch="Uniform"
                            Data="{StaticResource pivot_shift_right}" />
                    </Grid>
                    <elements:MouseWheelSlider
                        Style="{StaticResource MouseWheelSliderStyle}"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        AutoToolTipPlacement="BottomRight"
                        AutoToolTipPrecision="2"
                        Maximum="1"
                        Minimum="-1"
                        SmallChange="0.01"
                        Value="{Binding ShiftValue}" />
                </DockPanel>
            </StackPanel>
</UserControl>
