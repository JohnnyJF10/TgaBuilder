<UserControl x:Class="TgaBuilderWpfUi.View.TransitionWindowShadowUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:elements="clr-namespace:TgaBuilderWpfUi.Elements"
             xmlns:ap="clr-namespace:TgaBuilderWpfUi.AttachedProperties"
             xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
             d:DataContext="{d:DesignInstance Type=viewmodel:ShadowViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             xmlns:converter="clr-namespace:TgaBuilderWpfUi.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/MouseWheelSliderStyle.xaml" />
                <ResourceDictionary Source="/Styles/ToggleButtonExStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:ColorStructToMediaColorConverter x:Key="ColorStructToMediaColorConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        Margin="8,6,8,8">
        <StackPanel
            DataContext="{Binding TransitionInVM}"
            Orientation="Horizontal"
            VerticalAlignment="Center">
            <elements:ToggleButtonEx
                Icon="{ui:SymbolIcon EyeDropper24}"
                Width="36"
                Height="36"
                Margin="0,0,5,0"
                IsChecked="{Binding IsShadowEyedropperMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ap:MouseOverInfoAP.InfoText="Pick shadow color from image" />
            <cp:PortableColorPicker
                Width="34"
                Height="30"
                Margin="4,0,0,0"
                SelectedColor="{Binding ShadowColor, Converter={StaticResource ColorStructToMediaColorConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ap:MouseOverInfoAP.InfoText="Choose shadow color drawn over background behind tile borders" />
        </StackPanel>

        <DockPanel
            Margin="0,8,0,0"
            ap:MouseOverInfoAP.InfoText="Shadow Size: maximum shadow extent in pixels from the tile border">
            <ui:SymbolIcon
                VerticalAlignment="Center"
                Width="14"
                Height="14"
                Symbol="Tab24" />
            <ui:SymbolIcon
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Width="14"
                Height="14"
                Symbol="TabInPrivate24" />
            <elements:MouseWheelSlider
                Style="{StaticResource MouseWheelSliderStyle}"
                Margin="5,0"
                VerticalAlignment="Center"
                AutoToolTipPlacement="BottomRight"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                Maximum="32"
                Minimum="0"
                SmallChange="1"
                Value="{Binding ShadowSize}" />
        </DockPanel>

        <DockPanel
            Margin="0,8,0,0"
            ap:MouseOverInfoAP.InfoText="Shadow Hardness (%): controls how quickly the shadow fades away from tile borders">
            <ui:SymbolIcon
                VerticalAlignment="Center"
                Width="14"
                Height="14"
                Symbol="PaintBrush24" />
            <ui:SymbolIcon
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Width="14"
                Height="14"
                Symbol="PaintBrush24" />
            <elements:MouseWheelSlider
                Style="{StaticResource MouseWheelSliderStyle}"
                Margin="5,0"
                VerticalAlignment="Center"
                AutoToolTipPlacement="BottomRight"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                Maximum="100"
                Minimum="0"
                SmallChange="1"
                Value="{Binding ShadowHardness}" />
        </DockPanel>
    </StackPanel>
</UserControl>
