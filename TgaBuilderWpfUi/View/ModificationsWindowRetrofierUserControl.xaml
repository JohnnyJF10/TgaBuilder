<UserControl x:Class="TgaBuilderWpfUi.View.ModificationsWindowRetrofierUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:elements="clr-namespace:TgaBuilderWpfUi.Elements"
             xmlns:ap="clr-namespace:TgaBuilderWpfUi.AttachedProperties"
             xmlns:viewmodel="clr-namespace:TgaBuilderLib.ViewModel;assembly=TgaBuilderLib"
             d:DataContext="{d:DesignInstance Type=viewmodel:RetrofierViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/MouseWheelSliderStyle.xaml" />
                <ResourceDictionary Source="/Styles/ToggleButtonExStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8,4,8,8">

        <TextBlock
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            d:Foreground="White"
            FontSize="11"
            Text="Replicates the limited TR1 / TR2 (Sega Saturn) colour space: channel quantization, an optional reduced palette and retro dithering."
            Margin="0,0,0,4" />

        <!-- Quantization combo + palette-limit toggle -->
        <DockPanel
            Margin="0,8,0,0"
            LastChildFill="True"
            ap:MouseOverInfoAP.InfoText="Quantization: rounds RGB channels to multiples of 4 (6-bit), 8 (5-bit) or 16 (4-bit). 5-bit is the classic TR look.">
            <elements:ToggleButtonEx
                DockPanel.Dock="Right"
                Width="36"
                Height="36"
                Margin="6,0,0,0"
                Icon="{ui:SymbolIcon Table24}"
                IsChecked="{Binding IsPaletteLimitEnabled}"
                ap:MouseOverInfoAP.InfoText="Limit palette: cap the texture to a maximum number of distinct colours (default off)." />
            <Path
                VerticalAlignment="Center"
                Fill="{DynamicResource TextFillColorPrimaryBrush}"
                d:Fill="White"
                Width="16"
                Height="16"
                Stretch="Uniform"
                Margin="5,0,8,0"
                Data="{StaticResource grid}" />
            <ComboBox
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                BorderThickness="0"
                SelectedIndex="{Binding SelectedQuantizationIndex, UpdateSourceTrigger=PropertyChanged}">
                <ComboBoxItem Content="No quantization" />
                <ComboBoxItem Content="6-bit  (× 4)" />
                <ComboBoxItem Content="5-bit  (× 8)" />
                <ComboBoxItem Content="4-bit  (× 16)" />
            </ComboBox>
        </DockPanel>

        <!-- Max colors (only when palette limit is enabled) -->
        <DockPanel
            Margin="0,8,0,0"
            Visibility="{Binding IsPaletteLimitEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
            ap:MouseOverInfoAP.InfoText="Max colours: the largest number of distinct colours kept in the texture (median-cut palette reduction).">
            <Path
                VerticalAlignment="Center"
                Fill="{DynamicResource TextFillColorPrimaryBrush}"
                d:Fill="White"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Margin="5,0,0,0"
                Data="{StaticResource color_background}" />
            <Path
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Fill="{DynamicResource TextFillColorPrimaryBrush}"
                d:Fill="White"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Data="{StaticResource color_background_accent}" />
            <elements:MouseWheelSlider
                Style="{StaticResource MouseWheelSliderStyle}"
                Margin="4,0"
                VerticalAlignment="Center"
                AutoToolTipPlacement="BottomRight"
                AutoToolTipPrecision="0"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                Maximum="256"
                Minimum="2"
                SmallChange="1"
                Value="{Binding MaxColors, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- Dither mode combo -->
        <DockPanel
            Margin="0,8,0,0"
            LastChildFill="True"
            ap:MouseOverInfoAP.InfoText="Dithering: ordered pattern applied before quantization (or as a standalone checker effect). Checkerboard gives the iconic alternating-pixel look.">
            <Path
                VerticalAlignment="Center"
                Fill="{DynamicResource TextFillColorPrimaryBrush}"
                d:Fill="White"
                Width="16"
                Height="16"
                Stretch="Uniform"
                Margin="5,0,8,0"
                Data="{StaticResource square_simple}" />
            <ComboBox
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                BorderThickness="0"
                SelectedIndex="{Binding SelectedDitherModeIndex, UpdateSourceTrigger=PropertyChanged}">
                <ComboBoxItem Content="No dithering" />
                <ComboBoxItem Content="Checkerboard" />
                <ComboBoxItem Content="Bayer 4×4" />
                <ComboBoxItem Content="Bayer 8×8" />
            </ComboBox>
        </DockPanel>

        <!-- Dither strength (only when a dither mode is selected) -->
        <DockPanel
            Margin="0,8,0,0"
            Visibility="{Binding IsDitherActive, Converter={StaticResource BoolToVisibilityConverter}}"
            ap:MouseOverInfoAP.InfoText="Dither strength: intensity of the dither pattern (0 = none, 100 = full).">
            <Path
                VerticalAlignment="Center"
                Fill="{DynamicResource TextFillColorPrimaryBrush}"
                d:Fill="White"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Margin="5,0,0,0"
                Data="{StaticResource circle_line}" />
            <Path
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Fill="{DynamicResource TextFillColorPrimaryBrush}"
                d:Fill="White"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Data="{StaticResource circle_hatching}" />
            <elements:MouseWheelSlider
                Style="{StaticResource MouseWheelSliderStyle}"
                Margin="4,0"
                VerticalAlignment="Center"
                AutoToolTipPlacement="BottomRight"
                AutoToolTipPrecision="0"
                Maximum="100"
                Minimum="0"
                SmallChange="1"
                Value="{Binding DitherStrengthPercent, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- Dither cell size (only when a dither mode is selected) -->
        <DockPanel
            Margin="0,8,0,0"
            Visibility="{Binding IsDitherActive, Converter={StaticResource BoolToVisibilityConverter}}"
            ap:MouseOverInfoAP.InfoText="Dither cell size: size in pixels of each dither block. 1 = classic single-pixel checker, larger = chunkier blocks.">
            <Path
                VerticalAlignment="Center"
                Fill="{DynamicResource TextFillColorPrimaryBrush}"
                d:Fill="White"
                Width="14"
                Height="8"
                Stretch="Uniform"
                Margin="5,0,0,0"
                Data="{StaticResource circle_small}" />
            <Path
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Fill="{DynamicResource TextFillColorPrimaryBrush}"
                d:Fill="White"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Data="{StaticResource circle}" />
            <elements:MouseWheelSlider
                Style="{StaticResource MouseWheelSliderStyle}"
                Margin="4,0"
                VerticalAlignment="Center"
                AutoToolTipPlacement="BottomRight"
                AutoToolTipPrecision="0"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                Maximum="8"
                Minimum="1"
                SmallChange="1"
                Value="{Binding DitherCellSize, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
    </StackPanel>
</UserControl>
